{
  "name": "x-analytics",
  "version": "1.0.0",
  "private": true,
  "description": "Personal X (Twitter) analytics: sync, history, weekly reports and a local dashboard.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "audit:x": "tsx scripts/audit.ts",
    "sync": "tsx scripts/sync.ts",
    "sync:x": "tsx scripts/sync.ts",
    "sync:full": "tsx scripts/sync.ts --full",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "classify": "tsx scripts/classify.ts",
    "weekly": "tsx scripts/weekly.ts",
    "test": "tsx scripts/selftest.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  }
}
