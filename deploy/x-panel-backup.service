[Unit]
Description=X-Panel database backup (keeps 14 daily copies)

[Service]
Type=oneshot
User=xpanel
Group=xpanel
WorkingDirectory=/opt/x-panel/app
Environment=HOME=/opt/x-panel
ExecStart=/usr/bin/node node_modules/tsx/dist/cli.mjs scripts/backup-db.ts
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
