[Unit]
Description=X-Panel daily 45-day incremental sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=xpanel
Group=xpanel
WorkingDirectory=/opt/x-panel/app
Environment=HOME=/opt/x-panel
ExecStart=/usr/bin/node node_modules/tsx/dist/cli.mjs scripts/sync.ts
TimeoutStartSec=15min
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
