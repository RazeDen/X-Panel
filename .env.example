# X API (OAuth 1.0a user context) - copy to .env and fill in. Never commit .env.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Optional: app-only token (public metrics only). Not required.
X_BEARER_TOKEN=

# Optional: twitterapi.io key for the Comments page (replies to your posts, with author name and avatar).
# About $0.15 per 1,000 comments; without it the Comments page stays empty.
TWITTERAPI_IO_KEY=
# Optional: more accounts to track, read through twitterapi.io with the key above (comma-separated handles).
# Each gets its own database (data/analytics-<handle>.db) and shows up in the sidebar account switcher.
# Public metrics only (no profile visits, link clicks or video retention). About $2 a month per account.
TWITTERAPI_ACCOUNTS=

# Optional overrides
# ANALYTICS_DB=./data/analytics.db
# ANALYTICS_TZ=Europe/Warsaw
