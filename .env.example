# X API (OAuth 1.0a user context) - copy to .env and fill in. Never commit .env.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Optional: app-only token (public metrics only). Not required.
X_BEARER_TOKEN=

# Optional: enables AI classification and the written weekly analysis.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optional overrides
# ANALYTICS_DB=./data/analytics.db
# ANALYTICS_TZ=Europe/Warsaw
